# すべてのファイルをデフォルトで無視
### all ignore ###
/*
/.**

# 管理対象のファイルをホワイトリストとして追記
### not ignore ###

# Zsh
!/.zshrc
!/.zshenv
!/.zprofile

# Vim
!/.vimrc

# tmux
!/.tmux.conf

# Git
!/.gitconfig
!/.gitignore_global

# Claude Code (user-global config, symlinked to ~/.claude/ by install.sh)
!/.config/
!/.config/claude/
!/.config/claude/CLAUDE.md
!/.config/claude/RTK.md
!/.config/claude/settings.json
!/.config/claude/statusline-command.sh
!/.config/claude/skills/
!/.config/claude/skills/**
# ホスト固有の上書き設定 (install.sh が hostname 一致時のみ ~/.claude/ へリンク)
!/.config/claude/hosts/
!/.config/claude/hosts/**

# Gemini CLI (user-global config, symlinked to ~/.gemini/ by install.sh)
!/.config/gemini/
!/.config/gemini/settings.json

# OpenAI Codex (user-global config, symlinked to ~/.codex/ by install.sh)
!/.config/codex/
!/.config/codex/config.toml
!/.config/codex/skills/
!/.config/codex/skills/**

# herdr (agent-aware terminal multiplexer, symlinked to ~/.config/herdr/ by install.sh)
!/.config/herdr/
!/.config/herdr/config.toml

# npm
!/.npmrc

# Scripts
!/.bin/
!/.bin/**

# CI
!/.github/
!/.github/**

# Repo files
!/AGENTS.md
!/README.md
!/LICENSE
!/CLAUDE.md
!/Brewfile
!.gitignore
!.gitkeep
