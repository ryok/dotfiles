{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 60,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SHELL": "/bin/zsh",
    "CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL": "1",
    "CLAUDE_CODE_IDE_SKIP_VALID_CHECK": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(npm:*)",
      "Bash(git:*)",
      "Bash(cargo:*)",
      "Bash(find:*)",
      "Bash(gh pr view)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(rg:*)",
      "Read(**)",
      "Read(**/.env.sample)",
      "Edit(~/projects/**)",
      "Edit(/private/tmp/**)",
      "WebFetch(domain:*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm:*)",
      "Bash(rm -rf:*)",
      "Bash(chmod 777:*)",
      "Bash(gh repo delete:*)",
      "Bash(nc:*)",
      "Read(**/*.env*)",
      "Read(**/*secrets*)",
      "Read(**/*token*.json)",
      "Read(**/*token*.txt)",
      "Read(**/*token*.yaml)",
      "Read(**/*token*.yml)",
      "Read(**/*token*.pem)",
      "Read(**/*_token*)",
      "Read(**/.token*)",
      "Read(**/*key)",
      "Read(id_rsa)",
      "Read(id_ed25519)",
      "Edit(**/*.env*)",
      "Edit(**/*secrets*)",
      "Edit(**/*token*.json)",
      "Edit(**/*token*.txt)",
      "Edit(**/*token*.yaml)",
      "Edit(**/*token*.yml)",
      "Edit(**/*token*.pem)",
      "Edit(**/*_token*)",
      "Edit(**/.token*)",
      "Edit(**/*key)",
      "Edit(id_rsa)",
      "Edit(id_ed25519)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git checkout:*)",
      "Bash(wget:*)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {},
  "outputStyle": "Explanatory",
  "language": "ja",
  "sandbox": {
    "enabled": false
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "preferredNotifChannel": "iterm2",
  "teammateMode": "tmux",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
